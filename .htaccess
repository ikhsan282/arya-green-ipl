Options -Indexes
ServerSignature Off

# PHP settings for shared hosting
<IfModule mod_php8.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 6M
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 6M
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect sensitive directories
<FilesMatch "\.(sql|log|env|md|sh|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config and includes
RedirectMatch 403 ^/arya-green-ipl/config/.*$
RedirectMatch 403 ^/arya-green-ipl/includes/.*$
RedirectMatch 403 ^/arya-green-ipl/database/.*$

# Block direct access to uploads (serve via PHP only if needed)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /arya-green-ipl/

    # Block access to hidden files
    RewriteRule ^\.  - [F,L]

    # Route root to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
