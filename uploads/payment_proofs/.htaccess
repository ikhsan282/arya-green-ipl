# Proteksi direktori upload berkas bukti pembayaran
# Matikan directory listing dan eksekusi skrip
Options -Indexes -ExecCGI

# Default: tolak semua akses berkas kecuali ekstensi gambar/PDF yang diizinkan
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^[a-zA-Z0-9_\.-]+\.(?i:jpe?g|png|webp|pdf)$">
        Require all granted
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^[a-zA-Z0-9_\.-]+\.(?i:jpe?g|png|webp|pdf)$">
        Allow from all
    </FilesMatch>
</IfModule>

# Pastikan semua berkas dilayani sebagai berkas statis biasa, bukan dieksekusi sebagai skrip
<FilesMatch ".*">
    SetHandler default-handler
</FilesMatch>

# Matikan engine PHP (mod_php) jika terpasang
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
