Options -Indexes

# Hanya endpoint publik yang boleh diakses; file berawalan "_" adalah helper internal.
<FilesMatch "^_">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
