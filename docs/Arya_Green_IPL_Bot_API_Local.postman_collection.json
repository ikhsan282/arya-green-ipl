{
	"info": {
		"_postman_id": "arya-green-ipl-bot-api-local",
		"name": "Arya Green IPL — Bot API (Local XAMPP)",
		"description": "Koleksi Postman untuk pengujian API Bot di server lokal XAMPP (port 8080). Sudah dilengkapi Pre-request Script otomatis untuk kalkulasi HMAC-SHA256.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const botKey = pm.collectionVariables.get('bot_key') || 'hermes-prod';",
					"const secret = pm.collectionVariables.get('bot_secret') || 'mj52qt4B68sJzw8mw8NLM6GG5H6CfFnJJrOoX3-e72w';",
					"const phone = pm.collectionVariables.get('sender_phone') || '6281398461650';",
					"",
					"const ts = Math.floor(Date.now() / 1000).toString();",
					"const method = pm.request.method.toUpperCase();",
					"const urlPath = '/' + pm.request.url.getPath().join('/');",
					"const queryString = pm.request.url.getQueryString();",
					"const fullUri = queryString ? `${urlPath}?${queryString}` : urlPath;",
					"",
					"let bodyStr = '';",
					"if (pm.request.body && pm.request.body.raw) {",
					"    bodyStr = pm.request.body.raw;",
					"}",
					"const bodySha256 = CryptoJS.SHA256(bodyStr).toString(CryptoJS.enc.Hex);",
					"",
					"const canonical = `${ts}\\n${method}\\n${fullUri}\\n${phone}\\n${bodySha256}`;",
					"const signature = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex);",
					"",
					"pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
					"pm.request.headers.upsert({ key: 'X-Bot-Key', value: botKey });",
					"pm.request.headers.upsert({ key: 'X-Bot-Timestamp', value: ts });",
					"pm.request.headers.upsert({ key: 'X-Bot-Phone', value: phone });",
					"pm.request.headers.upsert({ key: 'X-Bot-Signature', value: signature });"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/arya-green-ipl",
			"type": "string"
		},
		{
			"key": "bot_key",
			"value": "hermes-prod",
			"type": "string"
		},
		{
			"key": "bot_secret",
			"value": "mj52qt4B68sJzw8mw8NLM6GG5H6CfFnJJrOoX3-e72w",
			"type": "string"
		},
		{
			"key": "sender_phone",
			"value": "6281398461650",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Identitas Warga (me.php)",
			"request": {
